ENVIRONMENT=production
AUTO_CREATE_TABLES=false
DATABASE_URL=postgresql://admin:replace-me@database:5432/wasteops_db
CORS_ORIGINS=https://erisa.binopsug.com
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
VERIFICATION_TOKEN_EXPIRE_HOURS=24
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

OTP_EXPIRE_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_DEVELOPMENT_MODE=false

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=replace@example.com
SMTP_PASSWORD=replace-with-app-password
SMTP_FROM_EMAIL=replace@example.com
SMTP_USE_TLS=true
SMTP_USE_SSL=false

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SMS_DEFAULT_COUNTRY_CODE=+256
