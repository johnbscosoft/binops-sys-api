APP_NAME="WasteCo Sys API"
API_V1_PREFIX="/api/v1"
AUTO_CREATE_TABLES=true
DATABASE_URL="postgresql://admin:admin123@localhost:5432/mydatabase"
CORS_ORIGINS="http://localhost:4200,http://127.0.0.1:4200"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
VERIFICATION_TOKEN_EXPIRE_HOURS=24
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# Two-factor authentication
ENVIRONMENT="development"
OTP_EXPIRE_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
# Development only: returns the OTP in the login response when delivery is not configured.
OTP_DEVELOPMENT_MODE=true

# Email OTP delivery
SMTP_HOST=""
SMTP_PORT=587
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL=""
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# SMS OTP delivery using Twilio
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
SMS_DEFAULT_COUNTRY_CODE="+256"
